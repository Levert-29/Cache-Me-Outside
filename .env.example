# =============================================================================
# Campus Clinic Appointment System - Environment Variables
# =============================================================================
# Copy this file to ".env.local" and fill in the values below.
# You can find the Supabase values in your v0 project settings
# (top-right settings menu -> Vars).
# =============================================================================

# --- Supabase (REQUIRED: auth + database) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Newer Supabase projects use a "publishable key" (starts with sb_publishable_).
# Older projects call it the "anon key". Either variable name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- Resend (OPTIONAL: needed only for confirmation/reminder emails) ---------
RESEND_API_KEY=your_resend_api_key

# --- Auth redirect (OPTIONAL: for local sign-up email confirmation) ----------
# Defaults to the current window origin if not set.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Cron reminders (OPTIONAL: only enforced in production) -------------------
CRON_SECRET=any_random_string
